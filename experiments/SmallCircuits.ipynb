   "metadata": {},
   "outputs": [],
   "source": [
    "def T_odd(x):\n",
    "    return (3*x+1)/2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9bf659e9-50fa-4318-a3ab-213e8cb57585",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = sympy.Symbol('x')\n",
    "k = sympy.Symbol('k')\n",
    "l = sympy.Symbol('l')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "6940ff8c-dca1-4bb2-b63e-7ada8e50c91c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle 2^{l} \\left(3^{k} - 1\\right)$"
      ],
      "text/plain": [
       "2**l*(3**k - 1)"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "a = 2**l * (3**k - 1)\n",
    "a"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "f5085dd3-1509-4f5b-ab9a-dba0c780d790",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{9 \\cdot 2^{l} \\left(3^{k} - 1\\right)}{4} + \\frac{5}{4}$"
      ],
      "text/plain": [
       "9*2**l*(3**k - 1)/4 + 5/4"
      ]
     },
     "execution_count": 15,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "T_odd(T_odd(a))"
   ]
  },
